// rant — Prisma schema
// Milestone 1: Auth · Organizations · Workspaces · Projects (+ RBAC + Audit)
// The schema is intentionally structured by domain so future modules
// (repositories, issues, deployments, monitoring, billing, ...) slot in cleanly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

/// Role a user holds within an organization. Drives RBAC everywhere.
enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  DEVELOPER
  QA
  DEVOPS
  VIEWER
  GUEST
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  ARCHIVED
  COMPLETED
}

enum ProjectVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum EpicStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum IssueType {
  TASK
  BUG
  STORY
  SUBTASK
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RepositoryVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum PullRequestStatus {
  DRAFT
  OPEN
  MERGED
  CLOSED
}

enum ReviewState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

/// What event started a pipeline run.
enum PipelineTrigger {
  PUSH
  PULL_REQUEST
  MANUAL
  SCHEDULE
}

/// Shared lifecycle status for runs, jobs and steps.
enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  SKIPPED
}

/// Kind of deployment target.
enum EnvironmentType {
  PRODUCTION
  PREVIEW
  STAGING
  DEVELOPMENT
}

/// Lifecycle of a single deployment.
enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  READY
  FAILED
  CANCELLED
}

/// How a monitor probes its target.
enum MonitorType {
  HTTP
  PING
}

/// Live health of a monitored environment.
enum MonitorStatus {
  UP
  DEGRADED
  DOWN
  PAUSED
  UNKNOWN
}

/// Lifecycle of an incident opened against a monitor.
enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// How badly an incident is hurting.
enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

// ─────────────────────────────────────────────────────────────
// Identity & Auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    OrganizationMembership[]
  refreshTokens  RefreshToken[]
  ownedOrgs      Organization[]           @relation("OrgOwner")
  auditLogs      AuditLog[]
  assignedIssues Issue[]                  @relation("IssueAssignee")
  reportedIssues Issue[]                  @relation("IssueReporter")
  comments       Comment[]
  commits             Commit[]      @relation("CommitAuthor")
  releases            Release[]     @relation("ReleaseAuthor")
  pullRequests        PullRequest[] @relation("PrAuthor")
  mergedPullRequests  PullRequest[] @relation("PrMergedBy")
  reviews             Review[]      @relation("ReviewAuthor")
  triggeredRuns       PipelineRun[] @relation("RunTriggeredBy")
  triggeredDeployments Deployment[] @relation("DeployTriggeredBy")

  @@map("users")
}

/// Persisted refresh tokens enable rotation + revocation (logout everywhere).
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Organizations & Membership (RBAC boundary)
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User                     @relation("OrgOwner", fields: [ownerId], references: [id])
  memberships  OrganizationMembership[]
  workspaces   Workspace[]
  repositories Repository[]
  auditLogs    AuditLog[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole          @default(DEVELOPER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

// ─────────────────────────────────────────────────────────────
// Workspaces (Notion-like container inside an org)
// ─────────────────────────────────────────────────────────────

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

// ─────────────────────────────────────────────────────────────
// Projects (Linear-like)
// ─────────────────────────────────────────────────────────────

model Project {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  key         String // short prefix, e.g. "RANT" -> RANT-123
  description String?
  status      ProjectStatus     @default(PLANNING)
  visibility  ProjectVisibility @default(PRIVATE)
  startDate   DateTime?
  targetDate  DateTime?
  /// Monotonic counter used to mint human-friendly issue numbers (KEY-123).
  issueCounter Int              @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprints      Sprint[]
  epics        Epic[]
  issues       Issue[]
  repositories Repository[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────
// Project management (Linear-style): Sprints · Epics · Issues · Comments
// ─────────────────────────────────────────────────────────────

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@map("sprints")
}

model Epic {
  id          String     @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      EpicStatus @default(OPEN)
  color       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@map("epics")
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String
  /// Per-project sequential number; rendered as `<project.key>-<number>`.
  number      Int
  title       String
  description String?
  type        IssueType     @default(TASK)
  status      IssueStatus   @default(BACKLOG)
  priority    IssuePriority @default(NONE)
  storyPoints Int?
  epicId      String?
  sprintId    String?
  parentId    String?
  assigneeId  String?
  reporterId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic     Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)
  sprint   Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent   Issue?    @relation("IssueSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children Issue[]   @relation("IssueSubtasks")
  assignee User?     @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User      @relation("IssueReporter", fields: [reporterId], references: [id])
  comments Comment[]
  incident Incident?

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([sprintId])
  @@index([epicId])
  @@index([assigneeId])
  @@map("issues")
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("comments")
}

// ─────────────────────────────────────────────────────────────
// Repositories (GitHub-style): repos · branches · commits · tags ·
// releases · pull requests · reviews · merge queue.
// Metadata layer — commits/SHAs are records, not real git objects.
// ─────────────────────────────────────────────────────────────

model Repository {
  id                 String               @id @default(cuid())
  organizationId     String
  projectId          String? // optional link to a project
  name               String
  slug               String
  description        String?
  visibility         RepositoryVisibility @default(PRIVATE)
  defaultBranch      String               @default("main")
  /// Monotonic counter used to mint PR numbers (#1, #2, ...).
  pullRequestCounter Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  branches     Branch[]
  commits      Commit[]
  tags         Tag[]
  releases     Release[]
  pullRequests PullRequest[]
  pipelines    Pipeline[]
  environments Environment[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("repositories")
}

model Branch {
  id            String   @id @default(cuid())
  repositoryId  String
  name          String
  headCommitSha String?
  isDefault     Boolean  @default(false)
  isProtected   Boolean  @default(false)
  createdAt     DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@index([repositoryId])
  @@map("branches")
}

model Commit {
  id           String   @id @default(cuid())
  repositoryId String
  sha          String
  message      String
  branch       String
  parentSha    String?
  authorId     String
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author     User       @relation("CommitAuthor", fields: [authorId], references: [id])

  @@unique([repositoryId, sha])
  @@index([repositoryId, branch])
  @@map("commits")
}

model Tag {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  commitSha    String
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@index([repositoryId])
  @@map("tags")
}

model Release {
  id           String   @id @default(cuid())
  repositoryId String
  tagName      String
  name         String
  body         String?
  isPrerelease Boolean  @default(false)
  authorId     String
  publishedAt  DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author     User       @relation("ReleaseAuthor", fields: [authorId], references: [id])

  @@unique([repositoryId, tagName])
  @@index([repositoryId])
  @@map("releases")
}

model PullRequest {
  id             String            @id @default(cuid())
  repositoryId   String
  number         Int
  title          String
  description    String?
  sourceBranch   String
  targetBranch   String
  status         PullRequestStatus @default(OPEN)
  authorId       String
  mergedById     String?
  mergeCommitSha String?
  mergedAt       DateTime?
  mergeQueuedAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author     User       @relation("PrAuthor", fields: [authorId], references: [id])
  mergedBy   User?      @relation("PrMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  reviews    Review[]
  pipelineRuns PipelineRun[]
  deployments  Deployment[]

  @@unique([repositoryId, number])
  @@index([repositoryId, status])
  @@map("pull_requests")
}

model Review {
  id            String      @id @default(cuid())
  pullRequestId String
  reviewerId    String
  state         ReviewState
  body          String?
  createdAt     DateTime    @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("ReviewAuthor", fields: [reviewerId], references: [id])

  @@index([pullRequestId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────
// CI/CD (GitHub-Actions-style): pipelines · runs · jobs · steps.
// A pipeline is a config attached to a repo; pushes and pull requests
// trigger runs, which a background worker executes step-by-step. A run's
// result feeds back into the PR merge gate — the first module where an
// action in one place (a commit) ripples into another (a blocked merge).
// ─────────────────────────────────────────────────────────────

model Pipeline {
  id           String            @id @default(cuid())
  repositoryId String
  name         String
  /// Declarative config: { jobs: [ { name, steps: [ { name, run } ] } ] }.
  definition   Json
  /// Which events auto-start this pipeline.
  triggers     PipelineTrigger[]
  /// Optional exact branch filter; null = every branch.
  branchFilter String?
  isActive     Boolean           @default(true)
  /// Monotonic counter used to mint per-pipeline run numbers (#1, #2, ...).
  runCounter   Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runs       PipelineRun[]

  @@unique([repositoryId, name])
  @@index([repositoryId])
  @@map("pipelines")
}

model PipelineRun {
  id            String          @id @default(cuid())
  pipelineId    String
  number        Int
  status        RunStatus       @default(QUEUED)
  trigger       PipelineTrigger
  branch        String
  commitSha     String?
  pullRequestId String?
  triggeredById String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime        @default(now())

  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pullRequest PullRequest?  @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  triggeredBy User?         @relation("RunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  jobs        PipelineJob[]

  @@unique([pipelineId, number])
  @@index([pipelineId, status])
  @@index([pullRequestId])
  @@map("pipeline_runs")
}

model PipelineJob {
  id         String    @id @default(cuid())
  runId      String
  name       String
  status     RunStatus @default(QUEUED)
  orderIdx   Int
  startedAt  DateTime?
  finishedAt DateTime?

  run   PipelineRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  steps PipelineStep[]

  @@index([runId])
  @@map("pipeline_jobs")
}

model PipelineStep {
  id         String    @id @default(cuid())
  jobId      String
  name       String
  command    String
  status     RunStatus @default(QUEUED)
  orderIdx   Int
  logs       String    @default("")
  startedAt  DateTime?
  finishedAt DateTime?

  job PipelineJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("pipeline_steps")
}

// ─────────────────────────────────────────────────────────────
// Deployments (Vercel-style): environments + deployments.
// This is where the ripple pays off — a successful CI run on the default
// branch auto-deploys to production, and a green PR gets a preview URL.
// A background worker builds + releases each deployment (simulated) and the
// environment's `currentDeployment` points at whatever is live right now.
// ─────────────────────────────────────────────────────────────

model Environment {
  id                  String          @id @default(cuid())
  repositoryId        String
  name                String
  slug                String
  type                EnvironmentType @default(PRODUCTION)
  /// Branch whose successful runs auto-deploy here (null = no auto-deploy).
  branchFilter        String?
  isProduction        Boolean         @default(false)
  /// The deployment currently serving this environment.
  currentDeploymentId String?         @unique
  /// Monotonic counter used to mint per-environment deployment numbers.
  deployCounter       Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  repository        Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  currentDeployment Deployment?  @relation("CurrentDeployment", fields: [currentDeploymentId], references: [id], onDelete: SetNull)
  deployments       Deployment[] @relation("EnvDeployments")
  monitor           Monitor?

  @@unique([repositoryId, slug])
  @@index([repositoryId])
  @@map("environments")
}

model Deployment {
  id            String           @id @default(cuid())
  environmentId String
  number        Int
  status        DeploymentStatus @default(QUEUED)
  branch        String
  commitSha     String?
  url           String?
  logs          String           @default("")
  pullRequestId String?
  triggeredById String?
  isRollback    Boolean          @default(false)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())

  environment Environment  @relation("EnvDeployments", fields: [environmentId], references: [id], onDelete: Cascade)
  activeFor   Environment? @relation("CurrentDeployment")
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  triggeredBy User?        @relation("DeployTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@unique([environmentId, number])
  @@index([environmentId, status])
  @@index([pullRequestId])
  @@map("deployments")
}

// ─────────────────────────────────────────────────────────────
// Monitoring (Datadog/Better-Uptime-style): monitors · metric samples ·
// incidents. This closes the DevOps loop — once a deployment goes live,
// a background scheduler probes its URL, records time-series health, and
// auto-opens (and resolves) incidents. A critical incident ripples back
// into project management by opening a bug issue on the linked project.
// The checks are simulated, like CI runs and deployments.
// ─────────────────────────────────────────────────────────────

model Monitor {
  id            String        @id @default(cuid())
  /// Exactly one monitor per environment.
  environmentId String        @unique
  name          String
  type          MonitorType   @default(HTTP)
  /// The URL currently being probed (mirrors the live deployment).
  target        String?
  /// Nominal probe interval in seconds (descriptive; the scheduler ticks globally).
  intervalSec   Int           @default(60)
  isActive      Boolean       @default(true)
  status        MonitorStatus @default(UNKNOWN)
  lastCheckedAt DateTime?
  /// Consecutive failed checks — drives the incident-open threshold.
  failCount     Int           @default(0)
  /// When set in the future, checks fail — used to inject an outage for demos.
  chaosUntil    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  environment Environment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  samples     MetricSample[]
  incidents   Incident[]

  @@index([environmentId])
  @@map("monitors")
}

model MetricSample {
  id         String        @id @default(cuid())
  monitorId  String
  status     MonitorStatus
  /// Response latency in milliseconds (0 when down).
  latencyMs  Int
  /// Simulated HTTP status code (200, 502, 503, ...).
  statusCode Int
  up         Boolean
  checkedAt  DateTime      @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("metric_samples")
}

model Incident {
  id         String           @id @default(cuid())
  monitorId  String
  status     IncidentStatus   @default(OPEN)
  severity   IncidentSeverity @default(MAJOR)
  title      String
  summary    String?
  /// Bug issue auto-created from this incident (the ripple into project mgmt).
  issueId    String?          @unique
  startedAt  DateTime         @default(now())
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([monitorId, status])
  @@map("incidents")
}

// ─────────────────────────────────────────────────────────────
// Audit (immutable event log — every meaningful action lands here)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String // e.g. "organization.created", "member.role_changed"
  targetType     String? // e.g. "Project"
  targetId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
