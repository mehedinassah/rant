# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://rant:rant@localhost:5432/rant?schema=public"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ─────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# ─── Auth (JWT) ──────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# ─── Web ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Public base URL of the web app (used to build invite / OAuth callback links).
WEB_URL="http://localhost:3000"

# ─── Email (optional) ────────────────────────────────────────
# Default transport logs to the console + in-memory outbox. Set RESEND_API_KEY
# (or MAIL_PROVIDER=resend) to send real email via Resend.
MAIL_PROVIDER=""                  # "console" (default) | "resend"
RESEND_API_KEY=""
MAIL_FROM="rant <onboarding@resend.dev>"

# ─── Object storage (optional) ───────────────────────────────
# Default stores file bytes in Postgres (storage_blobs). Set S3_BUCKET (or
# STORAGE_PROVIDER=s3) to use S3 / Cloudflare R2 / MinIO with presigned URLs.
STORAGE_PROVIDER=""               # "db" (default) | "s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                    # e.g. https://<account>.r2.cloudflarestorage.com

# ─── GitHub integration (optional) ───────────────────────────
# Register a GitHub App and fill these to enable real repo/CI/PR sync.
# Leave blank to keep the integration disabled (default).
FEATURE_GITHUB=""                 # "true"/"false" to force; blank = on when configured
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""         # base64-encoded PEM (or raw PEM with \n escapes)
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_SLUG=""                # app slug, for building the install URL
