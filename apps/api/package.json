    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@rant/database": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
