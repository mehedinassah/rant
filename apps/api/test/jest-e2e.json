{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "isolatedModules": true } }]
  },
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "testTimeout": 40000,
  "maxWorkers": 1
}
