{
  "name": "rant",
  "version": "0.1.0",
  "private": true,
  "description": "rant — the operating system for modern software teams",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @rant/database run generate",
    "db:push": "pnpm --filter @rant/database run push",
    "db:migrate": "pnpm --filter @rant/database run migrate",
    "db:seed": "pnpm --filter @rant/database run seed",
    "db:studio": "pnpm --filter @rant/database run studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
